diff --git a/ucm2/NXP/BT-SCO.conf b/ucm2/NXP/BT-SCO.conf
new file mode 100644
index 0000000..d84ea4c
--- /dev/null
+++ b/ucm2/NXP/BT-SCO.conf
@@ -0,0 +1,42 @@
+SectionVerb {
+	EnableSequence [
+	]
+}
+
+SectionDevice."BT-SCO-uplink" {
+	Comment "BT SCO"
+
+	ConflictingDevice [
+	]
+
+	EnableSequence [
+	]
+
+	DisableSequence [
+	]
+
+	Value {
+		PlaybackPriority "100"
+		PlaybackChannels 1
+		PlaybackPCM "hw:${CardId}"
+	}
+}
