diff --git a/ucm2/NXP/wm8960.conf b/ucm2/NXP/wm8960.conf
new file mode 100644
index 0000000..60b0ebc
--- /dev/null
+++ b/ucm2/NXP/wm8960.conf
@@ -0,0 +1,70 @@
+SectionVerb {
+	EnableSequence [
+	]
+}
+
+SectionDevice."Speaker" {
+	Comment "Speaker"
+
+	ConflictingDevice [
+		"Headphones"
+	]
+
+	EnableSequence [
+	]
+
+	DisableSequence [
+	]
+
+	Value {
+		PlaybackPriority "500"
+		PlaybackVolume "name='Speaker Playback Volume'"
+		PlaybackMixerElem "Speaker"
+		PlaybackPCM "hw:${CardId}"
+	}
+}
+
+SectionDevice."Headphones" {
+	Comment "Headphones"
+
+	ConflictingDevice [
+		"Speaker"
+	]
+
+	EnableSequence [
+	]
+
+	DisableSequence [
+	]
+
+	Value {
+		PlaybackPriority "1000"
+		PlaybackVolume "name='Headphone Playback Volume'"
+		PlaybackMixerElem "Headphone"
+		PlaybackPCM "hw:${CardId}"
+		JackControl "Headphone Jack"
+	}
+}
+
+SectionDevice."Headset" {
+        Comment "Headset Microphone"
+
+        ConflictingDevice [
+        ]
+
+        EnableSequence [
+                cset "name='Capture Switch' on,on"
+        ]
+
+        DisableSequence [
+                cset "name='Capture Switch' off,off"
+        ]
+
+        Value {
+                CapturePriority "100"
+                CaptureVolume "name='Capture Volume'"
+                CaptureMixerElem "Capture"
+                CapturePCM "hw:${CardId}"
+                JackControl "Headphone Jack"
+        }
+}
