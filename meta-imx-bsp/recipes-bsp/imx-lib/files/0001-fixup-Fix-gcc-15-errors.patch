 ipu/ipu.h               | 1 +
 2 files changed, 2 insertions(+)

diff --git a/hdmi-cec/mxc_hdmi-cec.c b/hdmi-cec/mxc_hdmi-cec.c
index 00ce32e..0baf808 100644
--- a/hdmi-cec/mxc_hdmi-cec.c
+++ b/hdmi-cec/mxc_hdmi-cec.c
@@ -20,6 +20,7 @@
  * @ingroup HDMI
  */
 
+#include <stdbool.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <stdint.h>
diff --git a/ipu/ipu.h b/ipu/ipu.h
index 1a55875..6ce175b 100644
--- a/ipu/ipu.h
+++ b/ipu/ipu.h
@@ -25,6 +25,7 @@
 #ifndef __ASM_ARCH_IPU_H__
 #define __ASM_ARCH_IPU_H__
 
+#include <stdbool.h>
 #include <linux/types.h>
 #include <linux/videodev2.h>
