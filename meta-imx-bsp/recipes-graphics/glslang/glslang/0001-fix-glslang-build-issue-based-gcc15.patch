From 085eb4f5a08e613ee32a9d8367f3df6107a3fae3 Mon Sep 17 00:00:00 2001
From: Ryan Zhang <ryan.zhang@nxp.com>
Date: Tue, 23 Sep 2025 18:30:12 +0800
Subject: [PATCH] fix glslang build issue based gcc15

https://gcc.gnu.org/gcc-15/porting_to.html#cxx
Some C++ Standard Library headers have been changed to
no longer include other headers that were being used
internally by the library.

Upstream-Status: Pending

Signed-off-by: Ryan Zhang <ryan.zhang@nxp.com>
---
 SPIRV/SpvBuilder.h | 1 +
 1 file changed, 1 insertion(+)

diff --git a/SPIRV/SpvBuilder.h b/SPIRV/SpvBuilder.h
index b1ca6ce1..00b2e53a 100644
--- a/SPIRV/SpvBuilder.h
+++ b/SPIRV/SpvBuilder.h
@@ -56,6 +56,7 @@ namespace spv {
 }
 
 #include <algorithm>
+#include <cstdint>
 #include <map>
 #include <memory>
 #include <set>
