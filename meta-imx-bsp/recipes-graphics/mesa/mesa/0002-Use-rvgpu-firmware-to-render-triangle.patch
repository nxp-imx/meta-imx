diff --git a/src/gallium/drivers/softpipe/sp_flush.c b/src/gallium/drivers/softpipe/sp_flush.c
index a5c786d6e0e..b74d31542d8 100644
--- a/src/gallium/drivers/softpipe/sp_flush.c
+++ b/src/gallium/drivers/softpipe/sp_flush.c
@@ -41,6 +41,9 @@
 #include "util/u_debug_image.h"
 #include "util/u_memory.h"
 #include "util/u_string.h"
+#ifdef RVGPU
+#include "fw_mesa_adaptor.h"
+#endif
 
 
 void
@@ -63,17 +66,37 @@ softpipe_flush( struct pipe_context *pipe,
       }
    }
 
+#ifdef RVGPU
+   if (!softpipe->mesa_sw_flag) {
+       AdpFlushTile(softpipe);
+   }
+#endif
+
    /* If this is a swapbuffers, just flush color buffers.
     *
     * The zbuffer changes are not discarded, but held in the cache
     * in the hope that a later clear will wipe them out.
     */
+#ifdef RVGPU
+   for (i = 0; i < softpipe->framebuffer.nr_cbufs; i++) {
+      if (softpipe->cbuf_cache[i] && (softpipe->mesa_sw_flag || softpipe->mesa_rendered)) {
+            sp_flush_tile_cache(softpipe->cbuf_cache[i]);
+      }
+   }
+
+   if (softpipe->zsbuf_cache && (softpipe->mesa_sw_flag || softpipe->mesa_rendered)) {
+      sp_flush_tile_cache(softpipe->zsbuf_cache);
+   }
+
+   softpipe->mesa_rendered = false;
+#else
    for (i = 0; i < softpipe->framebuffer.nr_cbufs; i++)
       if (softpipe->cbuf_cache[i])
          sp_flush_tile_cache(softpipe->cbuf_cache[i]);
 
    if (softpipe->zsbuf_cache)
       sp_flush_tile_cache(softpipe->zsbuf_cache);
+#endif
 
    softpipe->dirty_render_cache = false;
 
