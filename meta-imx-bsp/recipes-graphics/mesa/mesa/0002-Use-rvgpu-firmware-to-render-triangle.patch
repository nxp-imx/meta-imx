diff --git a/src/gallium/drivers/softpipe/sp_clear.c b/src/gallium/drivers/softpipe/sp_clear.c
index bc896db073b..e550941aabd 100644
--- a/src/gallium/drivers/softpipe/sp_clear.c
+++ b/src/gallium/drivers/softpipe/sp_clear.c
@@ -40,7 +40,9 @@
 #include "sp_screen.h"
 #include "sp_query.h"
 #include "sp_tile_cache.h"
-
+#ifdef RVGPU
+#include "fw_mesa_adaptor.h"
+#endif
 
 /**
  * Clear the given buffers to the specified values.
@@ -57,6 +59,9 @@ softpipe_clear(struct pipe_context *pipe, unsigned buffers,
    unsigned zs_buffers = buffers & PIPE_CLEAR_DEPTHSTENCIL;
    uint64_t cv;
    uint i;
+#ifdef RVGPU
+   bool clearColor = false;
+#endif
 
    if (unlikely(sp_debug & SP_DBG_NO_RAST))
       return;
@@ -70,11 +75,47 @@ softpipe_clear(struct pipe_context *pipe, unsigned buffers,
 
    if (buffers & PIPE_CLEAR_COLOR) {
       for (i = 0; i < softpipe->framebuffer.nr_cbufs; i++) {
-         if (buffers & (PIPE_CLEAR_COLOR0 << i))
+         if (buffers & (PIPE_CLEAR_COLOR0 << i)) {
             sp_tile_cache_clear(softpipe->cbuf_cache[i], color, 0);
+#ifdef RVGPU
+            clearColor = true;
+#endif
+         }
+      }
+   }
+
+#ifdef RVGPU
+   bool clearZs = false;
+   if (zs_buffers &&
+       util_format_is_depth_and_stencil(zsbuf->texture->format) &&
+       zs_buffers != PIPE_CLEAR_DEPTHSTENCIL) {
+      assert(softpipe->mesa_rendered == false);
+      if (softpipe->mesa_sw_flag) {
+          /* Clearing only depth or stencil in a combined depth-stencil buffer. */
+          util_clear_depth_stencil(pipe, zsbuf, zs_buffers, depth, stencil,
+                               0, 0, zsbuf->width, zsbuf->height);
       }
+      else
+      {
+          AdpFlushTile(softpipe);
+          clearZs = true;
+      }
+   }
+   else if (zs_buffers) {
+       clearZs = true;
    }
 
+   if (clearZs) {
+      static const union pipe_color_union zero;
+
+      cv = util_pack64_z_stencil(zsbuf->format, depth, stencil);
+      sp_tile_cache_clear(softpipe->zsbuf_cache, &zero, cv);
+   }
+
+   if (!softpipe->mesa_sw_flag && (clearColor || clearZs)) {
+      AdpClearTile(buffers, softpipe, clearColor, clearZs, zs_buffers);
+   }
+#else
    if (zs_buffers &&
        util_format_is_depth_and_stencil(zsbuf->texture->format) &&
        zs_buffers != PIPE_CLEAR_DEPTHSTENCIL) {
@@ -88,6 +129,7 @@ softpipe_clear(struct pipe_context *pipe, unsigned buffers,
       cv = util_pack64_z_stencil(zsbuf->format, depth, stencil);
       sp_tile_cache_clear(softpipe->zsbuf_cache, &zero, cv);
    }
+#endif
 
    softpipe->dirty_render_cache = true;
 }
