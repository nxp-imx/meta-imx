    FREE(mach->Instructions);
    mach->Instructions = instructions;
    mach->NumInstructions = numInstructions;
+
+#ifdef RVGPU
+   if (!mach->mesa_sw_flag) {
+      AdpBindTgsiShader(mach);
+   }
+#endif
 }
 
 
@@ -1218,6 +1227,22 @@ tgsi_exec_machine_create(enum pipe_shader_type shader_type)
 
    memset(mach, 0, sizeof(*mach));
 
+#ifdef RVGPU
+   char* mesaSwEnv = NULL;
+   static bool firsttime = true;
+   static bool mesaSW;
+
+   if (firsttime) {
+      mesaSwEnv = getenv("MESA_SW");
+      if (mesaSwEnv != NULL && strcmp(mesaSwEnv, "0")) {
+         mesaSW = true;
+      } else {
+         mesaSW = false;
+      }
+   }
+   mach->mesa_sw_flag = mesaSW;
+#endif
+
    mach->ShaderType = shader_type;
 
    if (shader_type != PIPE_SHADER_COMPUTE) {
