 #include "tgsi/tgsi_scan.h"
 #include "tgsi/tgsi_exec.h"
-
-
-struct exec_vertex_shader {
-   struct draw_vertex_shader base;
-   struct tgsi_exec_machine *machine;
-};
-
+#ifdef RVGPU
+#include "fw_mesa_adaptor.h"
+#endif
 
 static struct exec_vertex_shader *
 exec_vertex_shader(struct draw_vertex_shader *vs)
@@ -104,6 +100,26 @@ vs_exec_run_linear(struct draw_vertex_shader *shader,
    unsigned slot;
    bool clamp_vertex_color = shader->draw->rasterizer->clamp_vertex_color;
 
+#ifdef RVGPU
+   char* mesaSwEnv = NULL;
+   static bool firsttime = true;
+   static bool mesaSW;
+
+   if (firsttime) {
+      mesaSwEnv = getenv("MESA_SW");
+      if (mesaSwEnv != NULL && strcmp(mesaSwEnv, "0")) {
+         mesaSW = true;
+      } else {
+         mesaSW = false;
+      }
+      firsttime = false;
+   }
+   if (!mesaSW) {
+      AdptSetupVertex(machine, input, output, count, shader->info.num_inputs, shader->info.num_outputs, input_stride, output_stride);
+      return;
+   }
+#endif
+
    assert(!shader->draw->llvm);
    tgsi_exec_set_constant_buffers(machine, PIPE_MAX_CONSTANT_BUFFERS,
                                   (const struct tgsi_exec_consts_info *)constants);
