From a64d081ddffaacf7f9885b192f8c5d0f027dfb31 Mon Sep 17 00:00:00 2001
From: Eric Guo <eric.guo@nxp.com>
Date: Wed, 23 Apr 2025 14:45:24 +0800
Subject: [PATCH 3/3] * Enable rvgpu vertex shader * Only check environment
 variable MESA_SW once * Fix assert issue while run glcts with MESA_SW=1

Upstream-Status: Inappropriate [i.MX specific]
Signed-off-by: Eric Guo <eric.guo@nxp.com>
---
 src/gallium/auxiliary/cso_cache/cso_context.c | 23 ++++++++++++++
 src/gallium/auxiliary/draw/draw_vs.h          |  4 +++
 src/gallium/auxiliary/draw/draw_vs_exec.c     | 30 ++++++++++++++-----
 src/gallium/auxiliary/tgsi/tgsi_exec.c        | 10 +------
 src/gallium/auxiliary/tgsi/tgsi_exec.h        |  2 +-
 .../auxiliary/tgsi/tgsi_info_opcodes.h        | 15 +++++++++-
 src/gallium/drivers/softpipe/sp_clear.c       | 20 ++++++-------
 src/gallium/drivers/softpipe/sp_context.c     |  1 +
 src/gallium/drivers/softpipe/sp_prim_vbuf.c   | 11 ++-----
 .../drivers/softpipe/sp_state_derived.c       | 12 ++++++++
 .../drivers/softpipe/sp_state_shader.c        |  4 ++-
 .../drivers/softpipe/sp_state_surface.c       |  4 +++
 src/gallium/include/pipe/p_shader_tokens.h    |  9 ++++--
 13 files changed, 105 insertions(+), 40 deletions(-)

diff --git a/src/gallium/auxiliary/cso_cache/cso_context.c b/src/gallium/auxiliary/cso_cache/cso_context.c
index fd24be07d2d..d897d5d6137 100644
--- a/src/gallium/auxiliary/cso_cache/cso_context.c
+++ b/src/gallium/auxiliary/cso_cache/cso_context.c
@@ -789,10 +789,33 @@ cso_set_framebuffer(struct cso_context *cso,
 {
    struct cso_context_priv *ctx = (struct cso_context_priv *)cso;
 
+#ifdef RVGPU
+   char* mesaSwEnv = NULL;
+   static bool firsttime = true;
+   static bool mesaSW;
+
+   if (firsttime) {
+      mesaSwEnv = getenv("MESA_SW");
+      if (mesaSwEnv != NULL && strcmp(mesaSwEnv, "0")) {
+         mesaSW = true;
+      } else {
+         mesaSW = false;
+      }
+      firsttime = false;
+   }
+#endif
+
    if (memcmp(&ctx->fb, fb, sizeof(*fb)) != 0) {
       util_copy_framebuffer_state(&ctx->fb, fb);
       ctx->base.pipe->set_framebuffer_state(ctx->base.pipe, fb);
    }
+#ifdef RVGPU
+   else {
+      if(!mesaSW) {
+         ctx->base.pipe->set_framebuffer_state(ctx->base.pipe, NULL);
+      }
+   }
+#endif
 }
 
 
diff --git a/src/gallium/auxiliary/draw/draw_vs.h b/src/gallium/auxiliary/draw/draw_vs.h
