+#ifdef RVGPU
+OPCODE(1, 0, COMP, LOAD_DEPTH)
+OPCODE(1, 0, COMP, STORE_DEPTH)
+#else
 OPCODE_GAP(81) /* removed */
 OPCODE_GAP(82) /* removed */
+#endif
 OPCODE(1, 1, COMP, CEIL)
 OPCODE(1, 1, COMP, I2F)
 OPCODE(1, 1, COMP, NOT)
@@ -91,7 +100,11 @@ OPCODE(1, 2, COMP, AND)
 OPCODE(1, 2, COMP, OR)
 OPCODE(1, 2, COMP, MOD)
 OPCODE(1, 2, COMP, XOR)
+#ifdef RVGPU
+OPCODE(1, 1, COMP, ZONLY_TEST)
+#else
 OPCODE_GAP(93) /* removed */
+#endif
 OPCODE(1, 2, OTHR, TXF, .is_tex = 1)
 OPCODE(1, 2, OTHR, TXQ, .is_tex = 1)
 OPCODE(0, 0, NONE, CONT)
@@ -253,5 +266,5 @@ OPCODE(1, 3, OTHR, LOD)
 OPCODE(1, 3, OTHR, ATOMINC_WRAP, .is_store = 1)
