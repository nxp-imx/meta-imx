+++ b/src/gallium/auxiliary/tgsi/tgsi_info_opcodes.h
@@ -65,7 +65,11 @@ OPCODE(0, 0, NONE, CAL, .is_branch = 1)
 OPCODE(0, 0, NONE, RET)
 OPCODE(1, 1, COMP, SSG)
 OPCODE(1, 3, COMP, CMP)
