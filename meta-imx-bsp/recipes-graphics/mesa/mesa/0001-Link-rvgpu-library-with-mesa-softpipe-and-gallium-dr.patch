From 0f700705771fd5a919e5d1901f0fdcfc6f7c4fdc Mon Sep 17 00:00:00 2001
From: Eric Guo <eric.guo@nxp.com>
Date: Tue, 30 Jan 2024 15:10:13 +0800
Subject: [PATCH 1/3] Link rvgpu library with mesa softpipe and gallium driver

Upstream-Status: Inappropriate [i.MX specific]
Signed-off-by: Eric Guo <eric.guo@nxp.com>
---
 meson.build                              | 7 +++++++
 meson_options.txt                        | 7 +++++++
 src/gallium/auxiliary/meson.build        | 2 +-
 src/gallium/drivers/softpipe/meson.build | 2 +-
 4 files changed, 16 insertions(+), 2 deletions(-)

diff --git a/meson.build b/meson.build
index 8963b314256..2ee7464926f 100644
--- a/meson.build
+++ b/meson.build
@@ -1984,6 +1984,13 @@ if with_osmesa
   endif
 endif
 
+
+if get_option('mesa-rvgpu')
+  dep_rvgpu = dependency('mesa-rvgpu')
+else
+  dep_rvgpu = null_dep
+endif
+
 # TODO: symbol mangling
 
 if with_platform_wayland
diff --git a/meson_options.txt b/meson_options.txt
index 500a2eb695f..378f27bdc7c 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -682,4 +682,11 @@ option(
   description : 'Build custom xmlconfig (driconf) support. If disabled, ' +
                 'the default driconf file is hardcoded into Mesa. ' +
                 'Requires expat.'
+)
+
+option(
+  'mesa-rvgpu',
+  type : 'boolean',
+  value : 'false',
+  description : 'Build with mesa-rvgpu support',
 )
\ No newline at end of file
diff --git a/src/gallium/auxiliary/meson.build b/src/gallium/auxiliary/meson.build
index 96b0272c69b..b20377e02d3 100644
--- a/src/gallium/auxiliary/meson.build
+++ b/src/gallium/auxiliary/meson.build
@@ -530,7 +530,7 @@ libgallium = static_library(
   gnu_symbol_visibility : 'hidden',
   dependencies : [
     dep_libdrm, dep_llvm, dep_dl, dep_m, dep_thread, dep_lmsensors, dep_ws2_32,
-    idep_nir, idep_nir_headers, idep_mesautil,
+    idep_nir, idep_nir_headers, idep_mesautil, dep_rvgpu
   ],
   build_by_default : false
 )
diff --git a/src/gallium/drivers/softpipe/meson.build b/src/gallium/drivers/softpipe/meson.build
index e3bdf7e480d..9b1b0f8c5c9 100644
--- a/src/gallium/drivers/softpipe/meson.build
+++ b/src/gallium/drivers/softpipe/meson.build
@@ -81,7 +81,7 @@ libsoftpipe = static_library(
   include_directories : [inc_gallium_aux, inc_gallium, inc_include, inc_src],
   c_args : [c_msvc_compat_args],
   gnu_symbol_visibility : 'hidden',
-  dependencies : idep_nir,
+  dependencies : [idep_nir, dep_rvgpu]
 )
 
 driver_swrast = declare_dependency(
-- 
2.34.1

