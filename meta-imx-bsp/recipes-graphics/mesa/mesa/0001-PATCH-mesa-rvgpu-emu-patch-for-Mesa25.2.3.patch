diff --git a/src/gallium/auxiliary/cso_cache/cso_context.c b/src/gallium/auxiliary/cso_cache/cso_context.c
index d4546978adc..03ece871577 100644
--- a/src/gallium/auxiliary/cso_cache/cso_context.c
+++ b/src/gallium/auxiliary/cso_cache/cso_context.c
@@ -779,10 +779,33 @@ cso_set_framebuffer(struct cso_context *cso,
 {
    struct cso_context_priv *ctx = (struct cso_context_priv *)cso;
 
+#ifdef RVGPU
+   char* mesaSwEnv = NULL;
+   static bool firsttime = true;
+   static bool mesaSW;
+
+   if (firsttime) {
+      mesaSwEnv = getenv("MESA_SW");
+      if (mesaSwEnv != NULL && strcmp(mesaSwEnv, "0")) {
+         mesaSW = true;
+      } else {
+         mesaSW = false;
+      }
+      firsttime = false;
+   }
+#endif
+
    if (memcmp(&ctx->fb, fb, sizeof(*fb)) != 0) {
       util_copy_framebuffer_state(&ctx->fb, fb);
       ctx->base.pipe->set_framebuffer_state(ctx->base.pipe, fb);
    }
+#ifdef RVGPU
+   else {
+      if(!mesaSW) {
+         ctx->base.pipe->set_framebuffer_state(ctx->base.pipe, NULL);
+      }
+   }
+#endif
 }
 
 
