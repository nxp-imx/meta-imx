From: Tom Hochstein <tom.hochstein@nxp.com>
Date: Fri, 12 Sep 2025 14:40:53 -0500
Subject: [PATCH] feat(cmake) Fix multilib install

Upstream-Status: Pending
Signed-off-by: Tom Hochstein <tom.hochstein@nxp.com>
---
 CMakeLists.txt | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index b6e15e0..d062fcf 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -187,8 +187,9 @@ install(DIRECTORY src/lib/
     PATTERN "backends*" EXCLUDE
     PATTERN "*.h")
 
+set(LIB_INSTALL_DIR "lib" CACHE STRING "Name of folder for library installation")
 install(TARGETS lvgl_linux
-    ARCHIVE DESTINATION lib
+    ARCHIVE DESTINATION ${LIB_INSTALL_DIR}
 )
 
 add_custom_target(run COMMAND ${EXECUTABLE_OUTPUT_PATH}/lvglsim DEPENDS lvglsim)
