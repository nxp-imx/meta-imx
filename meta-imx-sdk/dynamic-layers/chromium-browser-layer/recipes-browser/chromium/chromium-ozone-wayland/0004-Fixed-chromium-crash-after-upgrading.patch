From 7104f3eb76e3efa58764a53fe125583dc228a806 Mon Sep 17 00:00:00 2001
From: Wujian Sun <wujian.sun_1@nxp.com>
Date: Wed, 22 Nov 2023 16:52:59 +0800
Subject: [PATCH 4/7] Fixed chromium crash after upgrading

Native display fail to get GBM platform,
add EGL_PLATFORM_GBM_KHR for WAYLAND_GBM.

Upstream-Status: Inappropriate [i.MX-specific]

Signed-off-by: Xianzhong Li <xianzhong.li@nxp.com
Signed-off-by: Wujian Sun <wujian.sun_1@nxp.com>

diff -Naur chromium-140.0.7339.136_org/ui/gfx/linux/gbm_device.h chromium-140.0.7339.136/ui/gfx/linux/gbm_device.h
--- chromium-140.0.7339.136_org/ui/gfx/linux/gbm_device.h	2025-10-21 13:36:08.294726727 -0500
+++ chromium-140.0.7339.136/ui/gfx/linux/gbm_device.h	2025-10-21 13:40:03.000000000 -0500
@@ -35,6 +35,8 @@
       gfx::NativePixmapHandle handle) = 0;
 
   virtual bool CanCreateBufferForFormat(uint32_t format) = 0;
+
+  virtual gbm_device* get() = 0;
 };
 
 }  // namespace ui
diff -Naur chromium-140.0.7339.136_org/ui/gfx/linux/gbm_wrapper.cc chromium-140.0.7339.136/ui/gfx/linux/gbm_wrapper.cc
--- chromium-140.0.7339.136_org/ui/gfx/linux/gbm_wrapper.cc	2025-10-21 13:36:08.294726727 -0500
+++ chromium-140.0.7339.136/ui/gfx/linux/gbm_wrapper.cc	2025-10-21 13:44:10.000000000 -0500
@@ -462,6 +462,8 @@
   }
 #endif
 
+gbm_device* get() {return device_.get();}
+
  private:
   std::vector<uint64_t> GetFilteredModifiers(
       uint32_t format,
diff -Naur chromium-140.0.7339.136_org/ui/ozone/platform/wayland/gpu/wayland_buffer_manager_gpu.cc chromium-140.0.7339.136/ui/ozone/platform/wayland/gpu/wayland_buffer_manager_gpu.cc
--- chromium-140.0.7339.136_org/ui/ozone/platform/wayland/gpu/wayland_buffer_manager_gpu.cc	2025-10-21 13:36:08.357727100 -0500
+++ chromium-140.0.7339.136/ui/ozone/platform/wayland/gpu/wayland_buffer_manager_gpu.cc	2025-10-21 13:46:16.000000000 -0500
@@ -321,8 +321,6 @@
   if (!supports_dmabuf_ || (!gl::GLSurfaceEGL::GetGLDisplayEGL()
                                  ->ext->b_EGL_EXT_image_dma_buf_import &&
                             !use_fake_gbm_device_for_test_)) {
-    supports_dmabuf_ = false;
-    return nullptr;
   }
 
   MaybeCreateGbmDevice();
diff -Naur chromium-140.0.7339.136_org/ui/ozone/platform/wayland/gpu/wayland_surface_factory.cc chromium-140.0.7339.136/ui/ozone/platform/wayland/gpu/wayland_surface_factory.cc
--- chromium-140.0.7339.136_org/ui/ozone/platform/wayland/gpu/wayland_surface_factory.cc	2025-10-21 13:36:08.358727106 -0500
+++ chromium-140.0.7339.136/ui/ozone/platform/wayland/gpu/wayland_surface_factory.cc	2025-10-21 13:48:50.000000000 -0500
@@ -173,6 +173,16 @@
 }
 
 gl::EGLDisplayPlatform GLOzoneEGLWayland::GetNativeDisplay() {
+  #if defined(WAYLAND_GBM)
+    GbmDevice* const device = buffer_manager_->GetGbmDevice();
+    if (device != nullptr) {
+      gbm_device* gbm = device->get();
+      if (gbm) {
+        return gl::EGLDisplayPlatform(
+            reinterpret_cast<EGLNativeDisplayType>(gbm), EGL_PLATFORM_GBM_KHR);
+      }
+    }
+  #endif
   if (connection_) {
     return connection_->GetNativeDisplay();
   }
